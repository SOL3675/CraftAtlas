{
  "targets": {
    "neoforge-1.21.1": {
      "java": {
        "gradle": "java21",
        "toolchain": 21,
        "game": "java21"
      },
      "build": "collector",
      "requiredSuites": [
        "atlas-server",
        "atlas-client",
        "atlas-offline"
      ],
      "tasks": {
        "build": [
          "build"
        ],
        "inspect": [
          "harnessExport"
        ]
      },
      "artifactManifest": "build/harness/neoforge-1.21.1.json",
      "minecraft": "1.21.1",
      "loader": "neoforge",
      "loaderVersion": "21.1.252"
    }
  },
  "builds": {
    "collector": {
      "adapter": "gradle",
      "root": "mods/collector",
      "java": "java21"
    }
  },
  "projectId": "craft-atlas",
  "runtimes": {
    "atlas-offline": {
      "kind": "server",
      "command": {
        "args": [
          "{projectRoot}/packages/harness/src/offline.ts",
          "{sessionRoot}"
        ],
        "executable": "node"
      },
      "capabilities": [
        "test-results"
      ]
    },
    "atlas-server": {
      "kind": "server",
      "command": {
        "args": [
          "{projectRoot}/packages/harness/src/server.ts",
          "{sessionRoot}",
          "{runRoot}",
          "{target}"
        ],
        "executable": "node"
      },
      "capabilities": [
        "dedicated-server"
      ]
    },
    "atlas-client": {
      "capabilities": [
        "integrated-server",
        "jei-runtime"
      ],
      "command": {
        "executable": "node",
        "args": [
          "{projectRoot}/packages/harness/src/client.ts",
          "{sessionRoot}",
          "{runRoot}",
          "{target}"
        ]
      },
      "kind": "client"
    },
    "atlas-negative": {
      "capabilities": [
        "dedicated-server"
      ],
      "command": {
        "executable": "node",
        "args": [
          "{projectRoot}/packages/harness/src/server.ts",
          "{sessionRoot}",
          "{runRoot}",
          "{target}",
          "--negative"
        ]
      },
      "kind": "server"
    }
  },
  "schemaVersion": 1,
  "suites": {
    "atlas-server": {
      "runtime": "atlas-server",
      "expectedTests": [
        "atlas.snapshot",
        "atlas.reload",
        "atlas.failure-fixture",
        "atlas.stopped"
      ],
      "driver": "process",
      "eulaRequired": true,
      "results": "results.json",
      "minTests": 4
    },
    "atlas-client": {
      "minTests": 3,
      "eulaRequired": true,
      "requiredCapabilities": [
        "integrated-server",
        "jei-runtime"
      ],
      "expectedTests": [
        "atlas.integrated",
        "atlas.jei",
        "atlas.client-stopped"
      ],
      "results": "results.json",
      "driver": "process",
      "runtime": "atlas-client"
    },
    "atlas-offline": {
      "expectedTests": [
        "atlas.contracts"
      ],
      "results": "results.json",
      "runtime": "atlas-offline",
      "driver": "process",
      "minTests": 1
    },
    "atlas-negative": {
      "minTests": 1,
      "eulaRequired": true,
      "expectedTests": [
        "atlas.expected-failure"
      ],
      "results": "results.json",
      "driver": "process",
      "runtime": "atlas-negative"
    }
  }
}
