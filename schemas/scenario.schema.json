{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://craft-atlas.local/schemas/scenario",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "inventory": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbiddenProcesses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowedTypes": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "supply": {
      "enum": [
        "renewable",
        "finite"
      ]
    },
    "closed": {
      "type": "boolean"
    },
    "closedResources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gameRules": {}
  },
  "required": [
    "schemaVersion",
    "id",
    "inventory",
    "equipment",
    "stages",
    "dimensions",
    "forbiddenProcesses",
    "allowedTypes",
    "supply",
    "closed",
    "closedResources",
    "gameRules"
  ]
}
