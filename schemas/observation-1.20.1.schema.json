{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "session",
    "generation",
    "minecraft",
    "loader",
    "loaderVersion",
    "environmentHash",
    "seed",
    "generator",
    "dimension",
    "difficulty",
    "biome",
    "position",
    "player",
    "gameTime",
    "dayTime",
    "weather",
    "gameRules",
    "trials",
    "totals",
    "limitations",
    "chunks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,80}$"
    },
    "kind": {
      "enum": [
        "loot",
        "world"
      ]
    },
    "session": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "minecraft": {
      "const": "1.20.1"
    },
    "loader": {
      "enum": [
        "forge",
        "fabric"
      ]
    },
    "loaderVersion": {
      "type": "string",
      "minLength": 1
    },
    "environmentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "seed": {
      "type": "string",
      "pattern": "^-?[0-9]+$"
    },
    "generator": {
      "type": "object"
    },
    "dimension": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "type": "string"
    },
    "biome": {
      "type": "string"
    },
    "position": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "player": {
      "type": [
        "object",
        "null"
      ]
    },
    "gameTime": {
      "type": "string"
    },
    "dayTime": {
      "type": "string"
    },
    "weather": {
      "type": "object"
    },
    "gameRules": {
      "type": "string"
    },
    "trials": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "totals": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "x",
          "z"
        ],
        "properties": {
          "x": {
            "type": "integer"
          },
          "z": {
            "type": "integer"
          }
        }
      },
      "minItems": 1,
      "maxItems": 9
    },
    "lootTable": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "object"
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "trial",
          "randomSeed",
          "outputs"
        ],
        "properties": {
          "trial": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999
          },
          "randomSeed": {
            "type": "string",
            "pattern": "^-?[0-9]+$"
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "resource",
                "amount",
                "stack"
              ],
              "properties": {
                "resource": {
                  "type": "string",
                  "minLength": 1
                },
                "amount": {
                  "type": "integer",
                  "minimum": 1
                },
                "stack": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "loot"
          }
        }
      },
      "then": {
        "required": [
          "lootTable",
          "context",
          "samples"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "world"
          }
        }
      },
      "then": {
        "properties": {
          "trials": {
            "maximum": 9
          },
          "chunks": {
            "items": {
              "required": [
                "x",
                "z",
                "wasLoaded",
                "minY",
                "maxY",
                "blockCounts",
                "biomes"
              ],
              "properties": {
                "wasLoaded": {
                  "type": "boolean"
                },
                "minY": {
                  "type": "integer"
                },
                "maxY": {
                  "type": "integer"
                },
                "blockCounts": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "biomes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              }
            }
          }
        }
      }
    }
  ]
}
