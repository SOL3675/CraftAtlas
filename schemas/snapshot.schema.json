{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://craft-atlas.local/schemas/snapshot",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "session": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "mode": {
      "enum": [
        "dedicated",
        "integrated"
      ]
    },
    "minecraft": {
      "type": "string",
      "minLength": 1
    },
    "loader": {
      "type": "string",
      "minLength": 1
    },
    "loaderVersion": {
      "type": "string",
      "minLength": 1
    },
    "collectorVersion": {
      "type": "string",
      "minLength": 1
    },
    "mods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "version"
        ]
      }
    },
    "environment": {},
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "components": {}
        },
        "required": [
          "id",
          "kind",
          "name",
          "evidence"
        ]
      }
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "data": {},
          "error": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "type",
          "data"
        ]
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dataset": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "complete",
              "partial",
              "unsupported",
              "failed"
            ]
          },
          "enumerated": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "interpreted": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "dataset",
          "type",
          "status",
          "enumerated",
          "interpreted",
          "reasons"
        ]
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "failed"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "status",
        "errors"
      ]
    },
    "viewer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "context": {},
        "recipes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "recipeId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "category": {
                "type": "string",
                "minLength": 1
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "alternatives": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "resource": {
                            "type": "string",
                            "minLength": 1
                          },
                          "tag": {
                            "type": "string",
                            "minLength": 1
                          },
                          "members": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "predicate": {},
                          "components": {}
                        },
                        "required": []
                      }
                    },
                    "amount": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    },
                    "consumption": {
                      "enum": [
                        "consumed",
                        "catalyst",
                        "durability"
                      ]
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "alternatives",
                    "amount",
                    "unit",
                    "consumption",
                    "evidence"
                  ]
                }
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "resource": {
                      "type": "string",
                      "minLength": 1
                    },
                    "amount": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    },
                    "role": {
                      "enum": [
                        "primary",
                        "byproduct",
                        "returned"
                      ]
                    },
                    "probability": {
                      "anyOf": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "components": {}
                  },
                  "required": [
                    "resource",
                    "amount",
                    "unit",
                    "role",
                    "probability",
                    "evidence"
                  ]
                }
              },
              "equipment": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "execution": {
                "enum": [
                  "display",
                  "unconfirmed"
                ]
              },
              "unknown": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "raw": {}
            },
            "required": [
              "id",
              "recipeId",
              "category",
              "inputs",
              "outputs",
              "equipment",
              "execution",
              "unknown",
              "raw"
            ]
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dataset": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "complete",
                  "partial",
                  "unsupported",
                  "failed"
                ]
              },
              "enumerated": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "interpreted": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "dataset",
              "type",
              "status",
              "enumerated",
              "interpreted",
              "reasons"
            ]
          }
        },
        "kind": {
          "enum": [
            "jei",
            "emi",
            "rei"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "session",
        "generation",
        "context",
        "recipes",
        "coverage"
      ]
    },
    "datapack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "selectedPacks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "loadedPacks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "disabledPacks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "effective": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "data": {},
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "text": {
                    "type": "string"
                  },
                  "bytesBase64": {
                    "type": "string"
                  },
                  "error": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "source",
                  "data"
                ]
              },
              "stack": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "data": {},
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "text": {
                      "type": "string"
                    },
                    "bytesBase64": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "source",
                    "data"
                  ]
                }
              }
            },
            "required": [
              "id",
              "effective",
              "stack"
            ]
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "directories",
        "selectedPacks",
        "loadedPacks",
        "disabledPacks",
        "resources",
        "limitations"
      ]
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lootTables": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "data": {},
              "error": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "type",
              "data"
            ]
          }
        },
        "lootModifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "data": {},
              "error": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "type",
              "data"
            ]
          }
        },
        "lootSources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "data": {},
              "error": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "type",
              "data"
            ]
          }
        },
        "biomes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "data": {},
              "error": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "type",
              "data"
            ]
          }
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "data": {},
              "error": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "type",
              "data"
            ]
          }
        },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "data": {},
              "error": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "type",
              "data"
            ]
          }
        },
        "observations": {
          "type": "array",
          "items": {}
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "lootTables",
        "lootModifiers",
        "lootSources",
        "biomes",
        "dimensions",
        "features",
        "limitations"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "session",
    "generation",
    "mode",
    "minecraft",
    "loader",
    "loaderVersion",
    "collectorVersion",
    "mods",
    "environment",
    "resources",
    "tags",
    "recipes",
    "coverage",
    "completion"
  ]
}
