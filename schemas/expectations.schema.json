{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://craft-atlas.local/schemas/expectations",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonemptyTags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supportedTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reachable": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unreachable": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "recipes",
    "nonemptyTags",
    "supportedTypes",
    "reachable",
    "unreachable"
  ]
}
