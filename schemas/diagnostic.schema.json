{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://craft-atlas.local/schemas/diagnostic",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "rule": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "error"
      ]
    },
    "status": {
      "enum": [
        "confirmed",
        "unknown"
      ]
    },
    "scenario": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "path": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unknown": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "snapshotId": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "rule",
    "target",
    "severity",
    "status",
    "scenario",
    "message",
    "evidence",
    "path",
    "unknown",
    "snapshotId"
  ]
}
