{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://craft-atlas.local/schemas/coverage",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "dataset": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "unsupported",
        "failed"
      ]
    },
    "enumerated": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "interpreted": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "dataset",
    "type",
    "status",
    "enumerated",
    "interpreted",
    "reasons"
  ]
}
